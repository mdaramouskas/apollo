# tpl-corporate — environment variables, grouped by module.
# Everything is OPTIONAL: with an empty .env the site builds and runs in demo mode
# (contact form logs to the server console, no analytics, no newsletter provider).
# Copy to .env.local for local dev; set in Vercel → Project → Settings → Environment Variables.
# NEVER commit .env* files (gitignored) and never `vercel deploy` from a dir containing one (.vercelignore).

# ── SEO-01 Technical SEO (recommended in production) ─────────────────────────
# Canonical URL used in metadata, sitemap, robots, JSON-LD. Falls back to https://<brand.domain>.
NEXT_PUBLIC_SITE_URL=

# ── INT-06 Google Search Console (optional) ──────────────────────────────────
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# ── EML-01 Transactional email — needed when CNT-05 (contact form) must really send
# Resend API key (https://resend.com → API Keys). Without it: demo mode.
RESEND_API_KEY=
# Verified sender, e.g. "Your Business <no-reply@yourdomain.com>" (domain verified in Resend).
EMAIL_FROM=
# Where contact-form messages go. Defaults to site.brand.email.
CONTACT_TO=

# ── INT-08 Newsletter — needed when INT-08 is on and integrations.newsletter != "none"
# provider "resend": reuses RESEND_API_KEY; optional segment id to add contacts to.
RESEND_SEGMENT_ID=
# provider "brevo":
BREVO_API_KEY=
BREVO_LIST_ID=

# ── INT-05 Analytics — needed when INT-05 is on (one of the two, matching integrations.analytics)
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA4_ID=

# ── SEC-02 Rate limiting — optional shared store (default: in-memory per instance)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── UI-15 Coming-soon gate — needed when UI-15 is on
# "1" activates the gate (every page → /coming-soon).
COMING_SOON=
# Secret: open any URL with ?preview=<value> to bypass the gate in your browser.
COMING_SOON_BYPASS=
